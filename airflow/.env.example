# Airflow core settings
# File ownership for mounted volumes. On Linux set this to your own uid (e.g. 1000).
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2

# Airflow UI admin account, created on first boot
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Encrypts Airflow connection passwords. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key

# AWS / S3 credentials
# Prefer an IAM role over static keys. Never commit real values.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=ap-south-1

# Snowflake credentials (used by dbt and the Airflow Snowflake provider)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password